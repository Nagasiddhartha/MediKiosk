# Database connection (PostgreSQL + pgvector)
DATABASE_URL=postgresql+psycopg2://medikiosk:medikiosk@127.0.0.1:5432/medikiosk

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_BYTES=10485760

# Optional Gemini API for enhanced multimodal OCR structuring and text-embedding-004
# (MediKiosk features an automatic offline deterministic fallback if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS
CORS_ORIGINS=http://localhost:3000
